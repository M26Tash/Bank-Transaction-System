# Copy this file to firebase.properties (it is git-ignored) and fill in your values.
# Environment variables FIREBASE_API_KEY and FIREBASE_CREDENTIALS override these.

# Firebase console -> Project settings -> General -> Web API Key
apiKey=PASTE_YOUR_WEB_API_KEY_HERE

# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# Keep the downloaded JSON file OUTSIDE this repository.
credentials=/path/outside/the/repo/firebase-service-account.json
