rules_version = '2';

// All data access goes through the app's Admin SDK, which bypasses these rules.
// Direct access from browsers or other clients is denied completely, so the
// database cannot be read or modified with just the public Web API key.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
